generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id    String @id @default(uuid())
  name  String @unique
  users User[]

  @@map("roles")
}

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  displayName     String?
  passwordHash    String?
  emailVerifiedAt DateTime?
  totpEnabled     Boolean   @default(false)
  marketingOptIn  Boolean   @default(false)
  deletedAt       DateTime?
  retainUntil     DateTime?
  roleId          String
  role            Role      @relation(fields: [roleId], references: [id])
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  totpSecret              TotpSecret?
  oauthIdentities         OAuthIdentity[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  addresses               Address[]
  cart                    Cart?
  orders                  Order[]
  reviews                 Review[]
  reviewVotes             ReviewVote[]
  auditLogs               AuditLog[]
  supportTickets          SupportTicket[]
  assistantThreads        AssistantThread[]

  @@map("users")
}

model TotpSecret {
  id          String    @id @default(uuid())
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  secret      String
  confirmedAt DateTime?
  backupCodes Json?

  @@map("totp_secrets")
}

model OAuthIdentity {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider       String
  providerUserId String
  createdAt      DateTime @default(now())

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("oauth_identities")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("email_verification_tokens")
}

model Category {
  id          String     @id @default(uuid())
  name        String
  slug        String     @unique
  description String?
  parentId    String?
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryTree")
  products    Product[]

  @@map("categories")
}

model Brand {
  id       String    @id @default(uuid())
  name     String
  slug     String    @unique
  products Product[]

  @@map("brands")
}

model Product {
  id             String   @id @default(uuid())
  name           String
  slug           String   @unique
  description    String
  price          Decimal  @db.Decimal(10, 2)
  promoPrice     Decimal? @db.Decimal(10, 2)
  promoStartsAt  DateTime?
  promoEndsAt    DateTime?
  lowestPriceBeforePromo Decimal? @db.Decimal(10, 2)
  wholesalePrice Decimal? @db.Decimal(10, 2)
  vatRate        Decimal  @default(25.5) @db.Decimal(5, 2)
  stockQuantity  Int
  categoryId     String
  category       Category @relation(fields: [categoryId], references: [id])
  brandId        String
  brand          Brand    @relation(fields: [brandId], references: [id])
  weightKg       Decimal  @db.Decimal(8, 3)
  weightLb       Decimal  @db.Decimal(8, 3)
  lengthCm       Decimal  @db.Decimal(8, 2)
  widthCm        Decimal  @db.Decimal(8, 2)
  heightCm       Decimal  @db.Decimal(8, 2)
  lengthIn       Decimal  @db.Decimal(8, 2)
  widthIn        Decimal  @db.Decimal(8, 2)
  heightIn       Decimal  @db.Decimal(8, 2)
  averageRating  Float    @default(0)
  reviewCount    Int      @default(0)
  featured       Boolean  @default(false)
  locatorStation Int      @default(1)
  locatorBlock   Int      @default(1)
  locatorShelf   Int      @default(1)
  locatorPlace   Int      @default(1)
  wholesalerId   String?
  wholesaler     Wholesaler? @relation(fields: [wholesalerId], references: [id], onDelete: SetNull)
  wholesaleSku   String?
  barcode        String?  @unique
  modelCode      String?
  colorName      String?
  warrantyMonths Int?
  warrantyNote   String?
  manufacturerUrl String?
  brandUrl       String?
  packageContents String?
  highlights     String?
  releaseYear    Int?
  energyClass    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  images         ProductImage[]
  attributes     ProductAttribute[]
  cartItems      CartItem[]
  orderItems     OrderItem[]
  reservations   InventoryReservation[]
  reviews        Review[]
  purchaseOrderItems PurchaseOrderItem[]
  priceHistory   ProductPriceHistory[]
  promotions     ProductPromotion[]

  @@index([categoryId])
  @@index([brandId])
  @@index([wholesalerId])
  @@index([price])
  @@index([averageRating])
  @@index([updatedAt])
  @@map("products")
}

model ProductPriceHistory {
  id         String   @id @default(uuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  price      Decimal  @db.Decimal(10, 2)
  recordedAt DateTime @default(now())

  @@index([productId, recordedAt])
  @@map("product_price_history")
}

model ProductPromotion {
  id                     String   @id @default(uuid())
  productId              String
  product                Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  regularPrice           Decimal  @db.Decimal(10, 2)
  promoPrice             Decimal  @db.Decimal(10, 2)
  startsAt               DateTime
  endsAt                 DateTime
  lowestPriceBeforePromo Decimal  @db.Decimal(10, 2)
  createdAt              DateTime @default(now())

  @@index([productId, startsAt])
  @@map("product_promotions")
}

model Wholesaler {
  id             String   @id @default(uuid())
  name           String
  slug           String   @unique
  email          String   @unique
  contactName    String?
  phone          String?
  address        String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  products       Product[]
  purchaseOrders PurchaseOrder[]

  @@map("wholesalers")
}

model PurchaseOrder {
  id           String   @id @default(uuid())
  reference    String   @unique
  wholesalerId String
  wholesaler   Wholesaler @relation(fields: [wholesalerId], references: [id], onDelete: Cascade)
  note         String?
  createdAt    DateTime @default(now())
  items        PurchaseOrderItem[]

  @@index([wholesalerId])
  @@index([createdAt])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String        @id @default(uuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId       String
  product         Product       @relation(fields: [productId], references: [id])
  productName     String
  wholesaleSku    String?
  quantity        Int
  stockOnHand     Int

  @@index([purchaseOrderId])
  @@index([productId])
  @@map("purchase_order_items")
}

model ProductImage {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  path      String
  thumbPath String?
  altText   String
  sortOrder Int     @default(0)

  @@index([productId])
  @@map("product_images")
}

model ProductAttribute {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  value     String

  @@index([productId])
  @@index([name, value])
  @@map("product_attributes")
}

enum OrderStatus {
  PENDING_PAYMENT
  PAYMENT_FAILED
  PAID
  PROCESSING
  SHIPPING
  WITH_COURIER
  DELIVERED
  CANCELLED
  REFUNDED
  CLAIMS
}

enum PaymentStatus {
  REQUIRES_PAYMENT
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
  REFUNDED
}

model Address {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label            String?
  recipientNameEnc String // AES-256-GCM
  line1Enc         String // AES-256-GCM
  line2Enc         String?
  cityEnc          String // AES-256-GCM
  regionEnc        String?
  postalEnc        String // AES-256-GCM
  country          String
  phoneEnc         String?
  isDefault        Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  shippingOrders   Order[]  @relation("ShippingAddress")

  @@index([userId])
  @@map("addresses")
}

model Cart {
  id         String     @id @default(uuid())
  userId     String?    @unique
  user       User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  guestToken String?    @unique // SHA-256 of the cookie; raw token is never stored
  expiresAt  DateTime?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  items      CartItem[]

  @@index([expiresAt])
  @@map("carts")
}

model CartItem {
  id        String   @id @default(uuid())
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, productId])
  @@index([productId])
  @@map("cart_items")
}

model Order {
  id                  String        @id @default(uuid())
  userId              String?
  user                User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  status              OrderStatus   @default(PENDING_PAYMENT)
  hasDeviation        Boolean       @default(false)
  currency            String        @default("EUR")
  subtotal            Decimal       @db.Decimal(10, 2)
  shippingCost        Decimal       @db.Decimal(10, 2)
  tax                 Decimal       @db.Decimal(10, 2)
  total               Decimal       @db.Decimal(10, 2)
  shippingMethod      String
  contactEmailEnc     String // AES-256-GCM
  contactNameEnc      String // AES-256-GCM
  contactPhoneEnc     String?
  shippingAddressEnc  String // AES-256-GCM JSON snapshot
  billingAddressEnc   String?
  shippingAddressId   String?
  shippingAddress     Address?      @relation("ShippingAddress", fields: [shippingAddressId], references: [id], onDelete: SetNull)
  trackingCarrier     String?
  trackingCode        String?
  shippedAt           DateTime?
  estimatedDeliveryFrom DateTime?
  estimatedDeliveryTo   DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  items               OrderItem[]
  events              OrderStatusEvent[]
  payment             Payment?
  reservations        InventoryReservation[]
  supportTickets      SupportTicket[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([updatedAt])
  @@map("orders")
}

model OrderItem {
  id            String  @id @default(uuid())
  orderId       String
  order         Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId     String
  product       Product @relation(fields: [productId], references: [id])
  productName   String
  quantity      Int
  unitPrice     Decimal @db.Decimal(10, 2)
  lineTotal     Decimal @db.Decimal(10, 2)
  thumbnailPath String?
  locatorCode   String?
  barcode       String?

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model OrderStatusEvent {
  id        String      @id @default(uuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())

  @@index([orderId])
  @@map("order_status_events")
}

model Payment {
  id                    String        @id @default(uuid())
  orderId               String        @unique
  order                 Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status                PaymentStatus @default(REQUIRES_PAYMENT)
  stripePaymentIntentId String? // Stripe id only — never PAN / CVC
  amount                Decimal       @db.Decimal(10, 2)
  currency              String        @default("EUR")
  metadataEnc           String? // AES-256-GCM (guest access hash, last error)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@map("payments")
}

model InventoryReservation {
  id         String    @id @default(uuid())
  orderId    String
  order      Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId  String
  product    Product   @relation(fields: [productId], references: [id])
  quantity   Int
  releasedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([orderId])
  @@index([productId])
  @@map("inventory_reservations")
}

enum ReviewStatus {
  PUBLISHED
  HIDDEN
}

model Review {
  id            String       @id @default(uuid())
  productId     String
  product       Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  stars         Int
  title         String?
  body          String
  helpfulCount  Int          @default(0)
  status        ReviewStatus @default(PUBLISHED)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  votes         ReviewVote[]

  @@unique([productId, userId])
  @@index([productId, helpfulCount])
  @@index([userId])
  @@map("reviews")
}

model ReviewVote {
  id        String   @id @default(uuid())
  reviewId  String
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([reviewId, userId])
  @@index([userId])
  @@map("review_votes")
}

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  metaEnc   String?
  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model ShippingOption {
  id            String   @id @default(uuid())
  code          String   @unique
  name          String
  description   String?
  price         Decimal  @db.Decimal(10, 2)
  freeThreshold Decimal? @db.Decimal(10, 2)
  minDays       Int
  maxDays       Int
  active        Boolean  @default(true)
  sortOrder     Int      @default(0)
  updatedAt     DateTime @updatedAt

  @@map("shipping_options")
}

model PackageSize {
  id               String         @id @default(uuid())
  code             String         @unique
  name             String
  lengthCm         Decimal        @db.Decimal(8, 2)
  widthCm          Decimal        @db.Decimal(8, 2)
  heightCm         Decimal        @db.Decimal(8, 2)
  maxWeightKg      Decimal        @db.Decimal(8, 3)
  stockQuantity    Int            @default(0)
  incomingQuantity Int            @default(0)
  sortOrder        Int            @default(0)
  active           Boolean        @default(true)
  updatedAt        DateTime       @updatedAt
  orders           PackageOrder[]

  @@map("package_sizes")
}

model PackageOrder {
  id            String      @id @default(uuid())
  reference     String      @unique
  packageSizeId String
  packageSize   PackageSize @relation(fields: [packageSizeId], references: [id], onDelete: Cascade)
  quantity      Int
  createdAt     DateTime    @default(now())

  @@index([packageSizeId])
  @@index([createdAt])
  @@map("package_orders")
}

model IntegrationApiKey {
  id          String    @id @default(uuid())
  name        String
  keyPrefix   String
  keyHash     String    @unique
  scopes      String[]
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  createdById String?

  @@map("integration_api_keys")
}

model IntegrationEndpoint {
  id         String    @id @default(uuid())
  name       String
  url        String
  secretEnc  String
  events     String[]
  active     Boolean   @default(true)
  lastStatus Int?
  lastError  String?
  lastSentAt DateTime?
  createdAt  DateTime  @default(now())

  @@map("integration_endpoints")
}

enum SupportTicketKind {
  ENQUIRY
  CLAIM
}

enum SupportTicketStatus {
  OPEN
  PENDING
  DONE
}

model SupportTicket {
  id             String              @id @default(uuid())
  reference      String              @unique
  externalKey    String              @unique
  kind           SupportTicketKind
  status         SupportTicketStatus @default(OPEN)
  subject        String
  message        String
  customerName   String
  customerEmail  String
  userId         String?
  user           User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  orderId        String?
  order          Order?              @relation(fields: [orderId], references: [id], onDelete: SetNull)
  payloadJson    String
  lastError      String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([createdAt])
  @@index([status])
  @@index([userId])
  @@map("support_tickets")
}

model AssistantThread {
  id        String              @id @default(uuid())
  userId    String?
  user      User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  messages  AssistantMessage[]

  @@index([userId])
  @@map("assistant_threads")
}

model AssistantMessage {
  id        String          @id @default(uuid())
  threadId  String
  thread    AssistantThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  role      String
  content   String
  uiBlocks  Json?
  createdAt DateTime        @default(now())

  @@index([threadId, createdAt])
  @@map("assistant_messages")
}
