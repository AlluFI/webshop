# Copy to .env (Docker Compose) and/or apps/api/.env (local API)

DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:15432/voltco?schema=public
REDIS_URL=redis://127.0.0.1:6379

JWT_ACCESS_SECRET=replace_with_at_least_32_random_characters
JWT_REFRESH_SECRET=another_secret_at_least_32_characters_long
JWT_ACCESS_EXPIRES_SEC=900
JWT_REFRESH_EXPIRES_SEC=604800

MAIL_HOST=127.0.0.1
MAIL_PORT=10250
MAIL_FROM=Volt & Co <no-reply@localhost>

WEB_APP_URL=http://localhost:5173
PORT=3000
COOKIE_SECURE=false
UPLOAD_DIR=uploads

# Google reCAPTCHA v2 test keys (always pass). Replace for a real deployment.
# https://developers.google.com/recaptcha/docs/faq#id-like-to-run-automated-tests-with-recaptcha.-what-should-i-do
RECAPTCHA_SITE_KEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI
RECAPTCHA_SECRET=6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe

# Optional — leave empty to hide Google sign-in
OAUTH_CALLBACK_BASE=http://localhost:3000/api/v1/auth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Web (Vite). Docker build args read VITE_* from the root .env
VITE_RECAPTCHA_SITE_KEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI
VITE_API_BASE=/api/v1
