# Copy to .env (Docker Compose) and/or apps/api/.env (local API)

DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:15432/voltco?schema=public
REDIS_URL=redis://127.0.0.1:6379

JWT_ACCESS_SECRET=replace_with_at_least_32_random_characters
JWT_REFRESH_SECRET=another_secret_at_least_32_characters_long
JWT_ACCESS_EXPIRES_SEC=900
JWT_REFRESH_EXPIRES_SEC=604800

MAIL_HOST=127.0.0.1
MAIL_PORT=10250
MAIL_FROM=Volt & Co <no-reply@localhost>

WEB_APP_URL=http://localhost:5173
PORT=3000
COOKIE_SECURE=false
UPLOAD_DIR=uploads

# Google reCAPTCHA v2 test keys (always pass). Replace for a real deployment.
# https://developers.google.com/recaptcha/docs/faq#id-like-to-run-automated-tests-with-recaptcha.-what-should-i-do
RECAPTCHA_SITE_KEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI
RECAPTCHA_SECRET=6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe

# Optional — leave empty to hide Google sign-in
OAUTH_CALLBACK_BASE=http://localhost:3000/api/v1/auth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AES-256-GCM key material (hashed to 32 bytes). Used for addresses and order snapshots.
DATA_ENCRYPTION_KEY=dev_data_encryption_key_must_be_32chars!

# Stripe test mode (Dashboard → Developers → API keys). Empty = checkout shows a 503 until set.
# Never commit live sk_live keys. Webhooks: `stripe listen --forward-to localhost:3000/api/v1/webhooks/stripe`
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# RabbitMQ (Compose default). Leave empty for API tests so payment handlers run in-process.
RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5672

# Carrier adapters. mock = Volt parcel label + demo tracking. live = real developer-portal APIs.
POSTI_MODE=mock
POSTI_CLIENT_ID=
POSTI_CLIENT_SECRET=
POSTI_OAUTH_URL=https://oauth2.posti.com/oauth/token
POSTI_SHIPMENT_URL=https://nextshipping.posti.fi/prinetti/create-shipment
POSTI_LABEL_URL=https://nextshipping.posti.fi/prinetti/get-shipping-label

POSTNORD_MODE=mock
POSTNORD_CLIENT_ID=
POSTNORD_CLIENT_SECRET=
POSTNORD_OAUTH_URL=https://api2.postnord.com/oauth2/token
POSTNORD_BOOKING_URL=https://api2.postnord.com/rest/booking/v1/bookings
POSTNORD_LABEL_URL=https://api2.postnord.com/rest/booking/v1/labels

BUDBEE_MODE=mock
BUDBEE_API_KEY=
BUDBEE_API_SECRET=
BUDBEE_BASE_URL=https://api.staging.budbee.com
BUDBEE_COLLECTION_ID=0

# Web (Vite). Docker build args read VITE_* from the root .env
VITE_RECAPTCHA_SITE_KEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI
VITE_API_BASE=/api/v1

# Integration keys use volt_test_ unless NODE_ENV=production (then volt_live_).
# Warehouse BI: grant SELECT on analytics_* views on a replica. See docs/INTEGRATIONS.md.
